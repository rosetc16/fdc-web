# Front-end config. Copy to .env for local dev, or set in your host's environment settings.

# The backend API URL. When set, the app uses real accounts, payments, and live data.
# When NOT set, the app runs in local/demo mode (simulated accounts, built-in sample data) —
# so the site still works before you connect the backend.
# Example: https://fdc-backend.onrender.com
VITE_API_URL=
